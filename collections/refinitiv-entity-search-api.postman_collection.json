{
  "info": {
    "_postman_id": "a9f60be4-2999-4001-8a31-2d07046e5c13",
    "name": "Refinitiv PermID Entity Search API",
    "description": "RESTful API enabling search of entities by name, ticker, or RIC to return PermIDs, or use PermIDs to retrieve entity information. PermID is an open and free entity identification scheme that provides a unique identifier for organizations, instruments, and quotes across approximately 13 million organizations and 3 million equity quotes.\n\nContact Support:\n Name: LSEG Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:33:02.000Z",
    "updatedAt": "2026-10-21T20:33:03.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-a9f60be4-2999-4001-8a31-2d07046e5c13"
  },
