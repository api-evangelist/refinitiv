      "item": [
        {
          "name": "Search Entities by Query",
          "id": "f1850d90-1d7b-4ab4-a163-a20328d9fc0f",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search?q=<string>&entitytype=instrument&num=5&start=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "description": "(Required) The search query string. Can be a name, ticker, RIC, ISIN, LEI, or PermID.",
                  "key": "q",
                  "value": "<string>"
                },
                {
                  "description": "Filter results by entity type.",
                  "key": "entitytype",
                  "value": "instrument"
                },
                {
                  "description": "Maximum number of results to return, default is 5.",
                  "key": "num",
                  "value": "5"
                },
                {
                  "description": "Starting index for pagination.",
                  "key": "start",
                  "value": "1"
                }
              ]
            },
            "description": "Searches for entities across organizations, equity instruments, and equity quotes. Supports searching by name, ticker, RIC, LEI, PermID, and other standard identifiers. Returns matching entities with their PermID identifiers and metadata."
