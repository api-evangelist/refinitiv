{
  "opencollection": "1.0.0",
  "info": {
    "name": "Refinitiv Data Platform (RDP) APIs Authentication Schedules API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Extraction Schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.refinitiv.com/Extractions/Schedules"
          },
          "docs": "Retrieves all extraction schedules defined in the user's account."
        }
      ]
    }
  ],
  "bundled": true
}