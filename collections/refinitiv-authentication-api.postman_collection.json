  "item": [
    {
      "id": "f1853dd4-235d-4a6f-85c6-597171a5d832",
      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 token management for obtaining and refreshing access tokens required by all other API endpoints.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ebc9355d-1987-4c6e-a0e4-8334abcb1eb9",
          "name": "Request Access Token",
          "request": {
            "name": "Request Access Token",
            "description": {
              "content": "Obtains an OAuth 2.0 access token using password grant or refresh token grant. The access token is required for all subsequent API calls and is valid for five minutes. The response also includes a refresh token that can be used to obtain new access tokens without re-authenticating.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "oauth2",
                "v1",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The application client ID provided during registration."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The OAuth 2.0 grant type. Use password for initial authentication or refresh_token for token renewal."
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "The user's machine account username. Required for password grant type."
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<string>",
                  "description": "The user's machine account password. Required for password grant type."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "The refresh token from a previous authentication. Required for refresh_token grant type."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "The scope of access requested. Each RDP resource has a permission scope assigned to it."
                },
                {
                  "disabled": false,
                  "key": "takeExclusiveSignOnControl",
                  "value": "<string>",
                  "description": "When set to true, forces sign-on even if another session exists for the same credentials."
                }
              ]
            }
          },
