          "name": "Verify Identity",
          "request": {
            "name": "Verify Identity",
            "description": {
              "content": "Submits an identity or document verification request. The API checks the submitted personal information against configured data sources for the specified country and returns verification results including match status for each data source queried.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "verifications",
                "v1",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
