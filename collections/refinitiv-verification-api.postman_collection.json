                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"AcceptTruliooTermsAndConditions\": \"<boolean>\",\n  \"ConfigurationName\": \"<string>\",\n  \"CountryCode\": \"XE\",\n  \"DataFields\": {\n    \"PersonInfo\": {\n      \"FirstGivenName\": \"<string>\",\n      \"MiddleName\": \"<string>\",\n      \"FirstSurName\": \"<string>\",\n      \"DayOfBirth\": \"<integer>\",\n      \"MonthOfBirth\": \"<integer>\",\n      \"YearOfBirth\": \"<integer>\",\n      \"Gender\": \"M\"\n    },\n    \"Location\": {\n      \"BuildingNumber\": \"<string>\",\n      \"UnitNumber\": \"<string>\",\n      \"StreetName\": \"<string>\",\n      \"StreetType\": \"<string>\",\n      \"Suburb\": \"<string>\",\n      \"StateProvinceCode\": \"<string>\",\n      \"PostalCode\": \"<string>\"\n    },\n    \"Communication\": {\n      \"Telephone\": \"<string>\",\n      \"EmailAddress\": \"<email>\"\n    },\n    \"CountrySpecific\": {\n      \"sunta20\": {\n        \"est7\": \"<string>\",\n        \"reprehenderit_2a5\": \"<string>\",\n        \"veniam_f_\": \"<string>\"\n      },\n      \"cillum_c9\": {\n        \"proident_6\": \"<string>\",\n        \"ea_b\": \"<string>\"\n      },\n      \"ex0fe\": {\n        \"sint_2\": \"<string>\",\n        \"incididunt_\": \"<string>\"\n      }\n    }\n  },\n  \"CleansedAddress\": \"<boolean>\",\n  \"ConsentForDataSources\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"VerboseMode\": \"<boolean>\"\n}",
